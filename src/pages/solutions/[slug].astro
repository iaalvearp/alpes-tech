---
import DetailView from "../../components/sections/DetailView.astro";
import { solutionsEn } from "../../data/details";

export function getStaticPaths() {
  return solutionsEn.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<DetailView
  item={item}
  lang="en"
  backHref="/#soluciones"
  backLabel="Back to Solutions"
/>
