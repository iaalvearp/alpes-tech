---
import DetailView from "../../../components/sections/DetailView.astro";
import { servicesEs } from "../../../data/details";

export function getStaticPaths() {
  return servicesEs.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<DetailView
  item={item}
  lang="es"
  backHref="/es/#servicios"
  backLabel="Volver a Servicios"
/>
