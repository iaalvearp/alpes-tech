---
import DetailView from "../../../components/sections/DetailView.astro";
import { solutionsEs } from "../../../data/details";

export function getStaticPaths() {
  return solutionsEs.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<DetailView
  item={item}
  lang="es"
  backHref="/es/#soluciones"
  backLabel="Volver a Soluciones"
/>
