---
import DetailView from "../../components/sections/DetailView.astro";
import { servicesEn } from "../../data/details";

export function getStaticPaths() {
  return servicesEn.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<DetailView
  item={item}
  lang="en"
  backHref="/#servicios"
  backLabel="Back to Services"
/>
