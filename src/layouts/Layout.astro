---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: string;
  lang?: "en" | "es";
}

const {
  title,
  description,
  canonical,
  socialTitle,
  socialDescription,
  socialImage,
  socialImageAlt,
  ogType = "website",
  lang = "en",
} = Astro.props;

const siteData = site[lang];
const defaultTitle = site.name;
const defaultDescription = siteData.description;

const fullTitle = !title
  ? `${defaultTitle} — ${siteData.tagline}`
  : `${title} — ${defaultTitle}`;
const metaDescription = description || defaultDescription;

// Imagen social predeterminada para páginas generales sin imagen propia.
const defaultSocialImage = "/servicios/consultoria.webp";
const defaultSocialImageAlt =
  lang === "es"
    ? "Alpes Tech — consultoría tecnológica y transformación digital"
    : "Alpes Tech — technology consulting and digital transformation";

const canonicalUrl = new URL(canonical || Astro.url.pathname, Astro.site);
const socialImagePath = socialImage || defaultSocialImage;
const socialImageUrl = new URL(socialImagePath, Astro.site);
const socialImageDimensions: Record<string, { width: number; height: number }> = {
  "/servicios/desarrollo.webp": { width: 1920, height: 1072 },
  "/servicios/comercializacion.webp": { width: 1620, height: 1080 },
  "/servicios/implementacion.webp": { width: 1620, height: 1080 },
  "/servicios/mantenimiento.webp": { width: 1919, height: 1080 },
  "/servicios/licenciamiento.webp": { width: 1620, height: 1080 },
  "/servicios/consultoria.webp": { width: 1620, height: 1080 },
  "/servicios/capacitacion.webp": { width: 1919, height: 1080 },
  "/soluciones/aplicaciones-moviles.webp": { width: 768, height: 419 },
  "/soluciones/plataformas-web.webp": { width: 768, height: 420 },
  "/soluciones/inteligencia-artificial.webp": { width: 768, height: 420 },
  "/soluciones/servicios-nube.webp": { width: 768, height: 419 },
  "/soluciones/comercio-electronico.webp": { width: 768, height: 428 },
};
const socialDimensions = socialImageDimensions[socialImagePath];
const resolvedSocialTitle = socialTitle || fullTitle;
const resolvedSocialDescription = socialDescription || metaDescription;
const resolvedSocialImageAlt = socialImageAlt || defaultSocialImageAlt;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Auto-detección de idioma del navegador (sin bucle: sessionStorage) -->
    <script is:inline>
      (function () {
        try {
          var KEY = "alpes-lang-redirect";
          if (sessionStorage.getItem(KEY)) return;
          sessionStorage.setItem(KEY, "1");

          var path = window.location.pathname;
          // Solo redirige desde la home en inglés ("/") para evitar rutas inexistentes.
          var isEnglishRoot = path === "/" || path === "/index.html";
          var lang = (
            navigator.language ||
            navigator.userLanguage ||
            "en"
          ).toLowerCase();

          if (isEnglishRoot && lang.indexOf("es") === 0) {
            window.location.replace("/es/");
          }
        } catch (e) {
          /* noop */
        }
      })();
    </script>

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedSocialTitle} />
    <meta property="og:description" content={resolvedSocialDescription} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:alt" content={resolvedSocialImageAlt} />
    {socialDimensions && (
      <>
        <meta property="og:image:width" content={socialDimensions.width} />
        <meta property="og:image:height" content={socialDimensions.height} />
      </>
    )}
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedSocialTitle} />
    <meta name="twitter:description" content={resolvedSocialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />

    <!-- Theme -->
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />

    <!-- 3D Tilt + Holographic Shine (Vanilla JS, ligero) -->
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!reduceMotion) {
        const MAX = 8; // grados máximos de inclinación
        const cards = document.querySelectorAll<HTMLElement>("[data-tilt]");

        cards.forEach((card) => {
          let raf = 0;

          function onMove(e: PointerEvent) {
            const rect = card.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width;
            const py = (e.clientY - rect.top) / rect.height;

            const rotateY = (px - 0.5) * (MAX * 2);
            const rotateX = (0.5 - py) * (MAX * 2);

            if (raf) cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
              card.style.setProperty("--mx", `${px * 100}%`);
              card.style.setProperty("--my", `${py * 100}%`);
            });
          }

          function onEnter() {
            card.classList.add("is-tilting");
          }

          function onLeave() {
            if (raf) cancelAnimationFrame(raf);
            card.classList.remove("is-tilting");
            card.style.transform = "";
            card.style.removeProperty("--mx");
            card.style.removeProperty("--my");
          }

          card.addEventListener("pointerenter", onEnter);
          card.addEventListener("pointermove", onMove);
          card.addEventListener("pointerleave", onLeave);
        });
      }
    </script>
  </body>
</html>
