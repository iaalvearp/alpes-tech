---
import SectionHeading from "../ui/SectionHeading.astro";
import {
  briefContent,
  type BriefChoiceQuestion,
  type BriefQuestion,
  type Lang,
} from "../../data/brief-content";
import {
  OTHER_FIELDS,
  TEXT_FIELDS,
  TEXT_LIMITS,
} from "../../data/brief-schema";
import { COUNTRIES } from "../../lib/countries";
import { normalizeText } from "../../lib/text";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = briefContent[lang];
const totalSteps = t.steps.length;

const countryName = (country: (typeof COUNTRIES)[number]) =>
  lang === "es" ? country.nameEs : country.nameEn;

const sortedCountries = [...COUNTRIES].sort((a, b) => {
  if (a.code === "EC") return -1;
  if (b.code === "EC") return 1;
  return countryName(a).localeCompare(countryName(b), lang, {
    sensitivity: "base",
  });
});

function isChoice(q: BriefQuestion): q is BriefChoiceQuestion {
  return q.type === "single" || q.type === "multi";
}

function limitFor(key: string): number {
  const kind = TEXT_FIELDS[key as keyof typeof TEXT_FIELDS];
  return kind ? TEXT_LIMITS[kind] : TEXT_LIMITS.short;
}

function otherFor(key: string): { option: string; field: string } | null {
  return (
    (OTHER_FIELDS as Record<string, { option: string; field: string }>)[key] ??
    null
  );
}

function otherContentFor(
  key: string,
): { label: string; placeholder: string; error: string } | null {
  return (
    (
      t.otherFields as Record<
        string,
        { label: string; placeholder: string; error: string }
      >
    )[key] ?? null
  );
}

function autocompleteFor(key: string): string | undefined {
  switch (key) {
    case "nombre":
      return "name";
    case "empresa":
      return "organization";
    case "correo":
      return "email";
    case "whatsapp":
      return "tel";
    default:
      return "off";
  }
}
---

<section class="brief-header" aria-label={lang === "es" ? "Cabecera del brief" : "Brief header"}>
  <div class="triangle-pattern brief-header-pattern" aria-hidden="true"></div>
  <div class="orb orb-primary brief-header-orb" aria-hidden="true"></div>

  <div class="container brief-header-content animate-fade-up">
    <SectionHeading
      eyebrow={t.eyebrow}
      title={t.heading}
      subtitle={t.subtitle}
      as="h1"
    />
  </div>
</section>

<section class="section brief-section">
  <div class="container brief-container">
    <div
      class="brief-wizard glass"
      data-brief
      data-lang={lang}
      data-total={totalSteps}
      data-progress-template={t.progress}
      data-required-error={t.requiredError}
      data-email-error={t.emailError}
      data-consent-error={t.consentError}
      data-error-text={t.errorText}
      data-sending-text={t.sending}
      data-email-suggestion-template={t.emailSuggestion}
      data-country-suggestion-template={t.countrySuggestion}
      data-phone-ec-error={t.phoneEcError}
      data-phone-length-error={t.phoneLengthError}
    >
      <div class="progress-wrap" data-progress-wrap>
        <div
          class="progress-track"
          role="progressbar"
          aria-valuemin="1"
          aria-valuemax={totalSteps}
          aria-valuenow="1"
          aria-label={t.progress.replace("{current}", "1").replace("{total}", String(totalSteps))}
          data-progress-bar
        >
          <div class="progress-fill" data-progress-fill></div>
        </div>
        <p class="progress-label" aria-live="polite" data-progress-label>
          {t.progress.replace("{current}", "1").replace("{total}", String(totalSteps))}
        </p>
      </div>

      <form novalidate data-brief-form>
        <input type="hidden" name="tiempo_ms" value="0" data-time />
        <div class="hp-field" aria-hidden="true">
          <label for="brief-hp">No rellenar</label>
          <input
            id="brief-hp"
            type="text"
            name="sitio_web"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        {
          t.steps.map((step, index) => (
            <section
              class="wizard-step"
              data-step={index + 1}
              hidden={index !== 0}
              aria-labelledby={`brief-step-${index + 1}`}
            >
              <h2 id={`brief-step-${index + 1}`} tabindex="-1">
                {step.title}
              </h2>
              {step.intro && <p class="step-intro">{step.intro}</p>}

              <div class="fields">
                {step.questions.map((q) =>
                  isChoice(q) ? (
                    <fieldset
                      class="field choice-field"
                      data-field={q.key}
                      data-conditional={q.showIf ? JSON.stringify(q.showIf) : undefined}
                      hidden={Boolean(q.showIf)}
                    >
                      <legend class="field-label">
                        {q.label}
                        {q.hint && <span class="field-hint">{q.hint}</span>}
                      </legend>
                      <div class="choices">
                        {q.options.map((option) => {
                          const other = otherFor(q.key);
                          const otherContent = otherContentFor(q.key);
                          return (
                            <>
                              <label class="choice">
                                <input
                                  class="choice-input"
                                  type={q.type === "multi" ? "checkbox" : "radio"}
                                  name={q.key}
                                  value={option.key}
                                  data-choice
                                />
                                <span class="choice-box" aria-hidden="true" />
                                <span class="choice-label">{option.label}</span>
                              </label>
                              {other &&
                                otherContent &&
                                other.option === option.key && (
                                  <div
                                    class="other-field"
                                    data-other-field={q.key}
                                    hidden
                                  >
                                    <label
                                      class="field-label"
                                      for={`brief-field-${other.field}`}
                                    >
                                      {otherContent.label}
                                    </label>
                                    <input
                                      class="text-input"
                                      id={`brief-field-${other.field}`}
                                      type="text"
                                      name={other.field}
                                      maxlength={limitFor(other.field)}
                                      placeholder={otherContent.placeholder}
                                      data-other-input
                                      data-other-error={otherContent.error}
                                      disabled
                                    />
                                    <p
                                      class="field-error"
                                      data-error-for={other.field}
                                      role="alert"
                                      hidden
                                    />
                                  </div>
                                )}
                            </>
                          );
                        })}
                      </div>
                      <p class="field-error" data-error-for={q.key} role="alert" hidden />
                    </fieldset>
                  ) : q.key === "pais" ? (
                    <div class="field" data-field="pais" data-country-field>
                      <label class="field-label" for="brief-field-pais">
                        {q.label}
                      </label>
                      <div class="country-combo" data-country-combo>
                        <div class="country-input-wrap">
                          <span class="country-flag" data-country-flag aria-hidden="true">
                            <img
                              src="/flags/ec.png"
                              width="24"
                              alt=""
                              data-country-flag-img
                              hidden
                            />
                            <svg
                              class="globe-icon"
                              data-country-globe
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="9"></circle>
                              <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
                            </svg>
                          </span>
                          <input
                            class="text-input country-input"
                            id="brief-field-pais"
                            type="text"
                            name="pais"
                            maxlength={limitFor("pais")}
                            placeholder={t.countryPlaceholder}
                            autocomplete="off"
                            role="combobox"
                            aria-expanded="false"
                            aria-controls="country-list-pais"
                            aria-autocomplete="list"
                            data-country-input
                          />
                        </div>
                        <ul
                          class="country-list"
                          id="country-list-pais"
                          role="listbox"
                          aria-label={t.countryListLabel}
                          hidden
                          data-country-list
                        >
                          {sortedCountries.map((country) => (
                            <li
                              class="country-option"
                              role="option"
                              id={`country-pais-${country.code}`}
                              aria-selected="false"
                              data-country-option
                              data-code={country.code}
                              data-name={countryName(country)}
                              data-dial={country.dial}
                              data-flag={country.flag}
                              data-search={normalizeText(
                                [country.nameEs, country.nameEn, ...country.aliases].join(" "),
                              )}
                            >
                              <img src={country.flag} width="24" alt="" loading="lazy" />
                              <span class="country-option-name">{countryName(country)}</span>
                              <span class="country-option-dial">+{country.dial}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <input
                        type="hidden"
                        name="pais_codigo"
                        value=""
                        data-country-code
                      />
                      <button
                        type="button"
                        class="suggestion"
                        data-country-suggestion
                        hidden
                      />
                    </div>
                  ) : q.key === "whatsapp" ? (
                    <div class="field" data-field="whatsapp">
                      <label class="field-label" for="brief-field-whatsapp">
                        {q.label}
                      </label>
                      <div class="phone-row">
                        <div class="phone-country" data-phone-country>
                          <button
                            type="button"
                            class="phone-trigger"
                            data-phone-trigger
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls="country-list-phone"
                            aria-label={t.phoneCountryLabel}
                          >
                            <img
                              src="/flags/ec.png"
                              width="24"
                              alt=""
                              data-phone-flag
                            />
                            <span class="phone-dial" data-phone-dial>+593</span>
                          </button>
                          <ul
                            class="country-list phone-list"
                            id="country-list-phone"
                            role="listbox"
                            aria-label={t.phoneCountryLabel}
                            hidden
                            data-phone-list
                          >
                            {sortedCountries.map((country) => (
                              <li
                                class="country-option"
                                role="option"
                                id={`country-phone-${country.code}`}
                                aria-selected="false"
                                data-country-option
                                data-code={country.code}
                                data-name={countryName(country)}
                                data-dial={country.dial}
                                data-flag={country.flag}
                                data-search={normalizeText(
                                  [country.nameEs, country.nameEn, ...country.aliases].join(" "),
                                )}
                              >
                                <img src={country.flag} width="24" alt="" loading="lazy" />
                                <span class="country-option-name">{countryName(country)}</span>
                                <span class="country-option-dial">+{country.dial}</span>
                              </li>
                            ))}
                          </ul>
                          <input
                            type="hidden"
                            name="whatsapp_pais"
                            value="EC"
                            data-phone-code
                          />
                        </div>
                        <input
                          class="text-input phone-input"
                          id={`brief-field-${q.key}`}
                          type="tel"
                          name={q.key}
                          maxlength={limitFor(q.key)}
                          placeholder={q.placeholder}
                          autocomplete="tel"
                          inputmode="tel"
                          data-phone-input
                        />
                      </div>
                      <p class="field-error" data-error-for={q.key} role="alert" hidden />
                    </div>
                  ) : (
                    <div
                      class="field"
                      data-field={q.key}
                      data-conditional={q.showIf ? JSON.stringify(q.showIf) : undefined}
                      hidden={Boolean(q.showIf)}
                    >
                      <label class="field-label" for={`brief-field-${q.key}`}>
                        {q.label}
                        {q.required && <span class="req" aria-hidden="true">*</span>}
                      </label>
                      {q.type === "textarea" ? (
                        <textarea
                          class="text-area"
                          id={`brief-field-${q.key}`}
                          name={q.key}
                          maxlength={limitFor(q.key)}
                          placeholder={q.placeholder}
                          required={q.required}
                        />
                      ) : (
                        <input
                          class="text-input"
                          id={`brief-field-${q.key}`}
                          type={q.type}
                          name={q.key}
                          maxlength={limitFor(q.key)}
                          placeholder={q.placeholder}
                          autocomplete={autocompleteFor(q.key)}
                          required={q.required}
                        />
                      )}
                      {q.key === "correo" && (
                        <button
                          type="button"
                          class="suggestion"
                          data-email-suggestion
                          hidden
                        />
                      )}
                      <p class="field-error" data-error-for={q.key} role="alert" hidden />
                    </div>
                  )
                )}
              </div>

              {index === totalSteps - 1 && (
                <div class="field consent-field" data-field="consentimiento">
                  <label class="consent-label">
                    <input type="checkbox" name="consentimiento" value="true" />
                    <span>{t.consentLabel}</span>
                  </label>
                  <p
                    class="field-error"
                    data-error-for="consentimiento"
                    role="alert"
                    hidden
                  />
                </div>
              )}
            </section>
          ))
        }

        <div class="wizard-actions">
          <button type="button" class="btn btn-secondary" data-back hidden>
            {t.back}
          </button>
          <button type="button" class="btn btn-primary" data-next>
            {t.next}
          </button>
          <button type="submit" class="btn btn-primary" data-submit hidden>
            {t.submit}
          </button>
        </div>

        <p class="form-status" role="alert" aria-live="assertive" data-form-status hidden />
        <p class="form-status-code" data-form-status-code hidden />
      </form>

      <div class="wizard-success" data-success hidden>
        <div class="success-icon" aria-hidden="true">✓</div>
        <h2 tabindex="-1">{t.successTitle}</h2>
        <p>{t.successText}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { OTHER_FIELDS } from "../../data/brief-schema";
  import { findByText, getByCode, suggestCountry } from "../../lib/countries";
  import { isValidEmail, suggestEmailFix } from "../../lib/email";
  import { normalizePhone } from "../../lib/phone";
  import { normalizeText } from "../../lib/text";

  const OTHER_ENTRIES = Object.entries(OTHER_FIELDS) as Array<
    [string, { option: string; field: string }]
  >;

  interface CountryComboApi {
    sync: () => void;
    applyCode: (code: string, fromUser?: boolean) => void;
    touched: () => boolean;
    value: () => string;
  }

  interface PhoneComboApi {
    sync: () => void;
    setCode: (code: string, fromUser?: boolean) => void;
    isTouched: () => boolean;
    code: () => string;
  }

  interface BriefApiResponse {
    ok?: boolean;
    error?: string;
    detail?: string;
  }

  function initBrief(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>("[data-brief-form]");
    if (!form) return;

    const lang = root.dataset.lang || "es";
    const total = Number(root.dataset.total || "6");
    const storageKey = `alpes-brief-draft-${lang}`;
    const progressTemplate =
      root.dataset.progressTemplate || "Paso {current} de {total}";
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const steps = Array.from(
      root.querySelectorAll<HTMLElement>("[data-step]"),
    );
    const progressWrap = root.querySelector<HTMLElement>("[data-progress-wrap]");
    const progressBar = root.querySelector<HTMLElement>("[data-progress-bar]");
    const progressFill = root.querySelector<HTMLElement>("[data-progress-fill]");
    const progressLabel = root.querySelector<HTMLElement>("[data-progress-label]");
    const backBtn = root.querySelector<HTMLButtonElement>("[data-back]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]");
    const submitBtn = root.querySelector<HTMLButtonElement>("[data-submit]");
    const statusEl = root.querySelector<HTMLElement>("[data-form-status]");
    const statusCodeEl = root.querySelector<HTMLElement>("[data-form-status-code]");
    const successEl = root.querySelector<HTMLElement>("[data-success]");
    const timeInput = root.querySelector<HTMLInputElement>("[data-time]");
    const consent = form.querySelector<HTMLInputElement>(
      'input[name="consentimiento"]',
    );
    const startedAt = Date.now();
    let stepIndex = 0;

    if (steps.length === 0) return;

    function control(name: string): HTMLInputElement | HTMLTextAreaElement | null {
      return form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `[name="${name}"]`,
      );
    }

    function getValue(name: string): string {
      const checked = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      return checked ? checked.value : "";
    }

    function clearStatus() {
      if (statusEl) {
        statusEl.hidden = true;
        statusEl.textContent = "";
      }
      if (statusCodeEl) {
        statusCodeEl.hidden = true;
        statusCodeEl.textContent = "";
      }
    }

    function showSubmitError(
      status: number | null,
      data: BriefApiResponse | null,
    ) {
      if (statusEl) {
        statusEl.textContent =
          root.dataset.errorText ||
          "No pudimos enviar tus respuestas. Inténtalo de nuevo.";
        statusEl.hidden = false;
      }

      if (statusCodeEl) {
        if (
          status !== null &&
          data &&
          typeof data.detail === "string" &&
          data.detail !== ""
        ) {
          const error =
            typeof data.error === "string" && data.error
              ? data.error
              : "error";
          statusCodeEl.textContent = `Código: ${status} ${error} — ${data.detail}`;
          statusCodeEl.hidden = false;
        } else {
          statusCodeEl.textContent = "";
          statusCodeEl.hidden = true;
        }
      }
    }

    function setError(name: string, message: string) {
      const error = root.querySelector<HTMLElement>(
        `[data-error-for="${name}"]`,
      );
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    }

    function clearError(name: string) {
      const error = root.querySelector<HTMLElement>(
        `[data-error-for="${name}"]`,
      );
      if (!error) return;
      error.textContent = "";
      error.hidden = true;
    }

    function clearStepErrors(section: HTMLElement) {
      section.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
        el.textContent = "";
        el.hidden = true;
      });
      section
        .querySelectorAll<HTMLElement>('[aria-invalid="true"]')
        .forEach((el) => el.removeAttribute("aria-invalid"));
    }

    function applyConditionals() {
      root.querySelectorAll<HTMLElement>("[data-conditional]").forEach((wrapper) => {
        let rule: { field?: string; equals?: string; notEquals?: string } = {};
        try {
          rule = JSON.parse(wrapper.dataset.conditional || "{}");
        } catch {
          rule = {};
        }
        if (!rule.field) return;

        const value = getValue(rule.field);
        let visible = true;
        if (rule.equals !== undefined) {
          visible = value === rule.equals;
        } else if (rule.notEquals !== undefined) {
          visible = value !== "" && value !== rule.notEquals;
        }

        wrapper.hidden = !visible;
        wrapper
          .querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
            "input, textarea, select",
          )
          .forEach((el) => {
            el.disabled = !visible;
          });
      });
    }

    function isOtherSelected(question: string, option: string): boolean {
      return Array.from(
        form!.querySelectorAll<HTMLInputElement>(`input[name="${question}"]`),
      ).some((input) => input.checked && input.value === option);
    }

    function syncOtherFields(focusQuestion?: string) {
      OTHER_ENTRIES.forEach(([question, config]) => {
        const wrapper = form!.querySelector<HTMLElement>(
          `[data-other-field="${question}"]`,
        );
        const input = wrapper?.querySelector<HTMLInputElement>(
          "[data-other-input]",
        );
        if (!wrapper || !input) return;

        const active = isOtherSelected(question, config.option);
        wrapper.hidden = !active;
        input.disabled = !active;

        if (!active) {
          input.value = "";
          input.removeAttribute("aria-invalid");
          clearError(config.field);
        } else if (focusQuestion === question) {
          input.focus();
        }
      });
    }

    function collect(): Record<string, string | string[]> {
      const data: Record<string, string | string[]> = {};
      form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        "input, textarea, select",
      ).forEach((el) => {
        if (!el.name || el.disabled) return;
        if (el.name === "sitio_web" || el.name === "tiempo_ms") return;
        if (el.name === "consentimiento") return;

        if (el instanceof HTMLInputElement && el.type === "checkbox") {
          if (!Array.isArray(data[el.name])) data[el.name] = [];
          if (el.checked) (data[el.name] as string[]).push(el.value);
        } else if (el instanceof HTMLInputElement && el.type === "radio") {
          if (el.checked) data[el.name] = el.value;
        } else {
          data[el.name] = el.value;
        }
      });
      return data;
    }

    function payload() {
      const data = collect();
      const clean: Record<string, unknown> = {};
      Object.keys(data).forEach((key) => {
        const value = data[key];
        if (Array.isArray(value)) {
          if (value.length > 0) clean[key] = value;
        } else if (typeof value === "string" && value.trim() !== "") {
          clean[key] = value.trim();
        }
      });
      clean.consentimiento = Boolean(consent?.checked);
      clean.lang = lang;
      clean.sitio_web = root.querySelector<HTMLInputElement>('[name="sitio_web"]')?.value || "";
      clean.tiempo_ms = Date.now() - startedAt;
      return clean;
    }

    function save() {
      try {
        localStorage.setItem(
          storageKey,
          JSON.stringify({ step: stepIndex, values: collect() }),
        );
      } catch {
        /* localStorage no disponible: el formulario sigue funcionando */
      }
    }

    function clearDraft() {
      try {
        localStorage.removeItem(storageKey);
      } catch {
        /* noop */
      }
    }

    function restore() {
      try {
        const raw = localStorage.getItem(storageKey);
        if (!raw) return;
        const saved = JSON.parse(raw) as {
          step?: number;
          values?: Record<string, string | string[]>;
        };
        if (!saved || typeof saved !== "object") return;

        const values = saved.values || {};
        Object.keys(values).forEach((name) => {
          const value = values[name];
          form!
            .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)
            .forEach((el) => {
              if (el instanceof HTMLInputElement && el.type === "radio") {
                el.checked = el.value === value;
              } else if (el instanceof HTMLInputElement && el.type === "checkbox") {
                el.checked = Array.isArray(value) && value.includes(el.value);
              } else if (typeof value === "string") {
                el.value = value;
              }
            });
        });

        if (Number.isInteger(saved.step)) {
          stepIndex = Math.min(Math.max(saved.step as number, 0), total - 1);
        }
      } catch {
        /* borrador inválido o inaccesible: se ignora */
      }
    }

    function showStep(next: number, focus = true) {
      stepIndex = Math.min(Math.max(next, 0), total - 1);
      steps.forEach((section, index) => {
        section.hidden = index !== stepIndex;
      });

      if (backBtn) backBtn.hidden = stepIndex === 0;
      if (nextBtn) nextBtn.hidden = stepIndex === total - 1;
      if (submitBtn) submitBtn.hidden = stepIndex !== total - 1;

      const percent = ((stepIndex + 1) / total) * 100;
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (progressBar) {
        progressBar.setAttribute("aria-valuenow", String(stepIndex + 1));
      }
      if (progressLabel) {
        progressLabel.textContent = progressTemplate
          .replace("{current}", String(stepIndex + 1))
          .replace("{total}", String(total));
      }

      clearStatus();
      applyConditionals();
      save();

      if (focus) {
        const heading = steps[stepIndex].querySelector<HTMLElement>("h2");
        if (heading) heading.focus({ preventScroll: true });
        const top = root.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({
          top,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      }
    }

    function validateStep(index: number): boolean {
      const section = steps[index];
      if (!section) return true;
      clearStepErrors(section);

      let firstInvalid: HTMLElement | null = null;

      OTHER_ENTRIES.forEach(([question, config]) => {
        const input = section.querySelector<HTMLInputElement>(
          `[name="${config.field}"]`,
        );
        if (!input || !isOtherSelected(question, config.option)) return;
        if (input.value.trim()) return;

        const message =
          input.dataset.otherError ||
          root.dataset.requiredError ||
          "Obligatorio";
        setError(config.field, message);
        input.setAttribute("aria-invalid", "true");
        if (!firstInvalid) firstInvalid = input;
      });

      if (index === 0) {
        ["nombre", "empresa", "correo"].forEach((name) => {
          const field = control(name);
          const value = field ? field.value.trim() : "";
          let message = "";

          if (!value) {
            message = root.dataset.requiredError || "Obligatorio";
          } else if (name === "correo" && !isValidEmail(value)) {
            message = root.dataset.emailError || "Correo inválido";
          }

          if (message && field) {
            setError(name, message);
            field.setAttribute("aria-invalid", "true");
            if (!firstInvalid) firstInvalid = field;
          }
        });
      }

      if (index === total - 1 && consent && !consent.checked) {
        setError(
          "consentimiento",
          root.dataset.consentError || root.dataset.requiredError || "Obligatorio",
        );
        consent.setAttribute("aria-invalid", "true");
        if (!firstInvalid) firstInvalid = consent;
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return false;
      }
      return true;
    }

    /* ── País: combobox con banderas ── */
    function setupCountryCombo(
      onChange?: (code: string | null) => void,
    ): CountryComboApi | null {
      const combo = root.querySelector<HTMLElement>("[data-country-combo]");
      const codeInput = root.querySelector<HTMLInputElement>("[data-country-code]");
      const suggestionBtn = root.querySelector<HTMLButtonElement>(
        "[data-country-suggestion]",
      );
      if (!combo || !codeInput) return null;

      const input = combo.querySelector<HTMLInputElement>("[data-country-input]");
      const list = combo.querySelector<HTMLElement>("[data-country-list]");
      const flagImg = combo.querySelector<HTMLImageElement>(
        "[data-country-flag-img]",
      );
      const globe = combo.querySelector<HTMLElement>("[data-country-globe]");
      if (!input || !list) return null;

      const options = Array.from(
        list.querySelectorAll<HTMLElement>("[data-country-option]"),
      );
      let filtered = options.slice();
      let activeIndex = -1;
      let isOpen = false;
      let touched = false;
      let suggestion: { code: string; nameEs: string; nameEn: string } | null =
        null;

      function showFlag(src: string | null) {
        if (flagImg) {
          if (src) {
            flagImg.src = src;
            flagImg.hidden = false;
          } else {
            flagImg.hidden = true;
          }
        }
        if (globe) globe.hidden = Boolean(src);
      }

      function refresh() {
        list!.hidden = !isOpen || filtered.length === 0;
        input!.setAttribute("aria-expanded", String(!list!.hidden));
      }

      function close() {
        isOpen = false;
        refresh();
        activeIndex = -1;
        input!.removeAttribute("aria-activedescendant");
        options.forEach((option) => {
          option.classList.remove("is-active");
        });
      }

      function open() {
        isOpen = true;
        refresh();
      }

      function filter(text: string) {
        const query = normalizeText(text);
        filtered = options.filter((option) =>
          query ? (option.dataset.search || "").includes(query) : true,
        );
        options.forEach((option) => {
          option.hidden = !filtered.includes(option);
        });
        activeIndex = -1;
        input!.removeAttribute("aria-activedescendant");
        options.forEach((option) => option.classList.remove("is-active"));
        refresh();
      }

      function setActive(index: number) {
        if (!filtered.length) return;
        activeIndex =
          ((index % filtered.length) + filtered.length) % filtered.length;
        filtered.forEach((option, position) => {
          option.classList.toggle("is-active", position === activeIndex);
        });
        const option = filtered[activeIndex];
        input!.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      }

      function setSelected(code: string | null) {
        options.forEach((option) => {
          option.setAttribute(
            "aria-selected",
            String(Boolean(code) && option.dataset.code === code),
          );
        });
      }

      function hideSuggestion() {
        suggestion = null;
        if (suggestionBtn) suggestionBtn.hidden = true;
      }

      function showSuggestion(country: {
        code: string;
        nameEs: string;
        nameEn: string;
      }) {
        if (!suggestionBtn) return;
        const name = root.dataset.lang === "en" ? country.nameEn : country.nameEs;
        suggestion = { code: country.code, nameEs: country.nameEs, nameEn: country.nameEn };
        const template =
          root.dataset.countrySuggestionTemplate || "¿Quisiste decir {country}?";
        suggestionBtn.textContent = template.replace("{country}", name);
        suggestionBtn.hidden = false;
      }

      function applyCode(code: string, fromUser = false, notify = true) {
        const option = options.find((item) => item.dataset.code === code);
        if (!option) return;

        input!.value = option.dataset.name || "";
        codeInput!.value = code;
        setSelected(code);
        showFlag(option.dataset.flag || null);
        hideSuggestion();
        filter("");
        close();
        if (fromUser) touched = true;
        if (notify) onChange?.(code);
        save();
      }

      function finalize() {
        const text = input!.value.trim();

        if (!text) {
          codeInput!.value = "";
          setSelected(null);
          showFlag(null);
          hideSuggestion();
          onChange?.(null);
          save();
          return;
        }

        const exact = findByText(text);
        if (exact) {
          applyCode(exact.code, true);
          return;
        }

        const nearby = suggestCountry(text);
        if (nearby) {
          showSuggestion(nearby);
        } else {
          hideSuggestion();
        }

        codeInput!.value = "otro";
        setSelected(null);
        showFlag(null);
        onChange?.(null);
        save();
      }

      input.addEventListener("focus", () => {
        filter(input.value);
        open();
      });

      input.addEventListener("input", () => {
        touched = true;
        hideSuggestion();
        codeInput!.value = "";
        showFlag(null);
        filter(input.value);
        open();
      });

      input.addEventListener("blur", () => {
        close();
        finalize();
      });

      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          if (!isOpen) {
            filter(input.value);
            open();
          }
          setActive(activeIndex + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          if (!isOpen) {
            filter(input.value);
            open();
          }
          setActive(activeIndex <= 0 ? filtered.length - 1 : activeIndex - 1);
        } else if (event.key === "Enter") {
          if (isOpen) {
            event.preventDefault();
            if (activeIndex >= 0 && filtered[activeIndex]) {
              applyCode(filtered[activeIndex].dataset.code || "", true);
            } else if (suggestion) {
              applyCode(suggestion.code, true);
            } else {
              finalize();
            }
          } else if (suggestion) {
            event.preventDefault();
            applyCode(suggestion.code, true);
          }
        } else if (event.key === "Escape") {
          event.preventDefault();
          close();
        }
      });

      list.addEventListener("mousedown", (event) => event.preventDefault());
      options.forEach((option) => {
        option.addEventListener("click", () => {
          applyCode(option.dataset.code || "", true);
        });
      });
      suggestionBtn?.addEventListener("click", () => {
        if (suggestion) applyCode(suggestion.code, true);
      });

      return {
        sync() {
          const text = input.value.trim();
          const exact = findByText(text);

          if (exact) {
            applyCode(exact.code, false, false);
          } else if (text) {
            if (!codeInput.value) codeInput.value = "otro";
            setSelected(null);
            showFlag(null);
            hideSuggestion();
          } else {
            codeInput.value = "";
            setSelected(null);
            showFlag(null);
            hideSuggestion();
          }
        },
        applyCode,
        touched: () => touched,
        value: () => input.value,
      };
    }

    /* ── WhatsApp: país y validación por país ── */
    function setupPhoneCombo(): PhoneComboApi | null {
      const wrap = root.querySelector<HTMLElement>("[data-phone-country]");
      const codeInput = root.querySelector<HTMLInputElement>("[data-phone-code]");
      if (!wrap || !codeInput) return null;

      const trigger = wrap.querySelector<HTMLButtonElement>("[data-phone-trigger]");
      const list = wrap.querySelector<HTMLElement>("[data-phone-list]");
      const flagImg = wrap.querySelector<HTMLImageElement>("[data-phone-flag]");
      const dial = wrap.querySelector<HTMLElement>("[data-phone-dial]");
      if (!trigger || !list) return null;

      const options = Array.from(
        list.querySelectorAll<HTMLElement>("[data-country-option]"),
      );
      let activeIndex = -1;
      let isOpen = false;
      let touched = false;

      function refresh() {
        list!.hidden = !isOpen;
        trigger!.setAttribute("aria-expanded", String(isOpen));
      }

      function close() {
        isOpen = false;
        activeIndex = -1;
        refresh();
        trigger!.removeAttribute("aria-activedescendant");
        options.forEach((option) => {
          option.classList.remove("is-active");
        });
      }

      function open() {
        isOpen = true;
        refresh();
      }

      function setActive(index: number) {
        if (!options.length) return;
        activeIndex = ((index % options.length) + options.length) % options.length;
        options.forEach((option, position) => {
          option.classList.toggle("is-active", position === activeIndex);
        });
        const option = options[activeIndex];
        trigger!.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      }

      function setCode(code: string, fromUser = false) {
        const option =
          options.find((item) => item.dataset.code === code) || options[0];
        if (!option) return;

        codeInput!.value = option.dataset.code || "";
        if (flagImg) flagImg.src = option.dataset.flag || "";
        if (dial) dial.textContent = `+${option.dataset.dial || ""}`;

        options.forEach((item) => {
          item.setAttribute("aria-selected", String(item === option));
        });

        if (fromUser) touched = true;
        close();
        save();
      }

      trigger.addEventListener("click", () => {
        if (isOpen) {
          close();
        } else {
          open();
          setActive(0);
        }
      });

      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (!isOpen) {
            open();
            setActive(0);
          } else {
            setActive(
              activeIndex + (event.key === "ArrowDown" ? 1 : options.length - 1),
            );
          }
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          if (!isOpen) {
            open();
            setActive(0);
          } else if (activeIndex >= 0) {
            setCode(options[activeIndex].dataset.code || "", true);
          }
        } else if (event.key === "Escape") {
          event.preventDefault();
          close();
        }
      });

      list.addEventListener("mousedown", (event) => event.preventDefault());
      options.forEach((option) => {
        option.addEventListener("click", () => {
          setCode(option.dataset.code || "", true);
        });
      });
      trigger.addEventListener("blur", close);

      return {
        sync() {
          if (getByCode(codeInput.value)) {
            setCode(codeInput.value, false);
          } else {
            setCode("EC", false);
          }
        },
        setCode,
        isTouched: () => touched,
        code: () => codeInput.value,
      };
    }

    /* ── Correo: error y sugerencias ── */
    function setupEmailHints() {
      const input = form!.querySelector<HTMLInputElement>('[name="correo"]');
      const button = root.querySelector<HTMLButtonElement>("[data-email-suggestion]");
      if (!input) return;

      let suggestion: string | null = null;

      function hideSuggestion() {
        suggestion = null;
        if (button) button.hidden = true;
      }

      function evaluate(showError: boolean) {
        const value = input!.value.trim();
        if (!value) {
          hideSuggestion();
          return;
        }

        const fixed = suggestEmailFix(value);
        if (fixed && button) {
          const template =
            root.dataset.emailSuggestionTemplate || "¿Quisiste decir {email}?";
          suggestion = fixed;
          button.textContent = template.replace("{email}", fixed);
          button.hidden = false;
        } else {
          hideSuggestion();
        }

        if (showError) {
          if (!isValidEmail(value)) {
            setError("correo", root.dataset.emailError || "Correo inválido");
          } else {
            clearError("correo");
          }
        }
      }

      input.addEventListener("blur", () => evaluate(true));
      input.addEventListener("input", hideSuggestion);

      button?.addEventListener("click", () => {
        if (!suggestion) return;
        input.value = suggestion;
        hideSuggestion();
        clearError("correo");
        save();
        input.focus();
      });
    }

    const phoneCombo = setupPhoneCombo();
    const countryCombo = setupCountryCombo((code) => {
      if (code && phoneCombo && !phoneCombo.isTouched()) {
        phoneCombo.setCode(code, false);
      }
    });
    setupEmailHints();

    const phoneInput = form.querySelector<HTMLInputElement>("[data-phone-input]");
    if (phoneInput) {
      phoneInput.addEventListener("input", () => {
        const cleaned = phoneInput.value.replace(/[^\d+\s-]/g, "");
        if (cleaned !== phoneInput.value) {
          const cursor = phoneInput.selectionStart ?? phoneInput.value.length;
          const kept = phoneInput.value
            .slice(0, cursor)
            .replace(/[^\d+\s-]/g, "").length;
          phoneInput.value = cleaned;
          phoneInput.setSelectionRange(kept, kept);
        }
        clearError("whatsapp");
      });

      phoneInput.addEventListener("blur", () => {
        const raw = phoneInput.value.trim();
        if (!raw) {
          clearError("whatsapp");
          return;
        }

        const result = normalizePhone(phoneCombo?.code(), raw);
        if (result.ok) {
          phoneInput.value = result.value;
          clearError("whatsapp");
          save();
          return;
        }

        const message =
          result.error === "ec_mobile_format"
            ? root.dataset.phoneEcError || ""
            : root.dataset.phoneLengthError || "";
        setError("whatsapp", message);
      });
    }

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLElement | null;
      if (target && "name" in target && (target as HTMLInputElement).name) {
        clearError((target as HTMLInputElement).name);
        target.removeAttribute("aria-invalid");
      }
      applyConditionals();
      save();
    });

    form.addEventListener("change", (event) => {
      const target = event.target as HTMLElement | null;
      if (target && "name" in target && (target as HTMLInputElement).name) {
        const name = (target as HTMLInputElement).name;
        clearError(name);
        target.removeAttribute("aria-invalid");

        const other = OTHER_ENTRIES.find(([question]) => question === name);
        const focusQuestion =
          other &&
          target instanceof HTMLInputElement &&
          target.checked &&
          target.value === other[1].option
            ? name
            : undefined;
        syncOtherFields(focusQuestion);
      }
      applyConditionals();
      save();
    });

    nextBtn?.addEventListener("click", () => {
      if (validateStep(stepIndex)) showStep(stepIndex + 1);
    });

    backBtn?.addEventListener("click", () => {
      showStep(stepIndex - 1);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (stepIndex !== total - 1) {
        if (validateStep(stepIndex)) showStep(stepIndex + 1);
        return;
      }

      // Los pasos anteriores también deben conservar sus obligatorios.
      const stepZeroOk = validateStep(0);
      if (!stepZeroOk) {
        showStep(0, false);
        validateStep(0);
        return;
      }
      if (!validateStep(total - 1)) return;

      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.textContent = root.dataset.sendingText || "Enviando...";
      form.setAttribute("aria-busy", "true");
      clearStatus();

      if (timeInput) timeInput.value = String(Date.now() - startedAt);

      try {
        const response = await fetch("/api/brief", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload()),
        });
        let data: BriefApiResponse | null = null;
        try {
          data = (await response.json()) as BriefApiResponse;
        } catch {
          data = null;
        }

        if (!response.ok || !data || data.ok !== true) {
          showSubmitError(response.status, data);
          submitBtn.disabled = false;
          submitBtn.textContent = tSubmitLabel();
          form.removeAttribute("aria-busy");
          return;
        }

        clearDraft();
        form.hidden = true;
        if (progressWrap) progressWrap.hidden = true;
        if (successEl) {
          successEl.hidden = false;
          const heading = successEl.querySelector<HTMLElement>("h2");
          if (heading) heading.focus();
        }
        const top = root.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" });
      } catch {
        showSubmitError(null, null);
        submitBtn.disabled = false;
        submitBtn.textContent = tSubmitLabel();
        form.removeAttribute("aria-busy");
      }
    });

    function tSubmitLabel(): string {
      return root.dataset.lang === "en" ? "Send" : "Enviar";
    }

    async function fillFromGeo() {
      try {
        const response = await fetch("/api/geo", {
          headers: { Accept: "application/json" },
        });
        if (!response.ok) return;

        const data = (await response.json()) as {
          country?: string | null;
          city?: string | null;
        };
        if (!data) return;

        const detected = getByCode(data.country || null);
        if (
          detected &&
          countryCombo &&
          countryCombo.value().trim() === "" &&
          !countryCombo.touched()
        ) {
          countryCombo.applyCode(detected.code, false);
        }

        if (typeof data.city === "string" && data.city.trim()) {
          const cityField = form!.querySelector<HTMLInputElement>(
            '[name="ciudad"]',
          );
          if (cityField && cityField.value.trim() === "") {
            cityField.value = data.city.trim();
            save();
          }
        }
      } catch {
        /* sin geolocalización: se deja vacío */
      }
    }

    restore();
    applyConditionals();
    syncOtherFields();
    showStep(stepIndex, false);
    if (timeInput) timeInput.value = "0";

    countryCombo?.sync();
    phoneCombo?.sync();
    void fillFromGeo();
  }

  document.querySelectorAll<HTMLElement>("[data-brief]").forEach(initBrief);
</script>

